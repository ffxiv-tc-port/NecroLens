<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/13.0.0">
    <PropertyGroup>
        <Authors>Jukka</Authors>
        <Description>NecroLens Dalamud Plugin</Description>
        <PackageProjectUrl>https://github.com/ffxiv-tc-port/NecroLens</PackageProjectUrl>
    </PropertyGroup>

    <PropertyGroup>
        <BuildNumberFile>$(MSBuildProjectDirectory)\BuildNumber.txt</BuildNumberFile>
        <_PreviousBuildNumber Condition="Exists('$(BuildNumberFile)')">$([System.IO.File]::ReadAllText('$(BuildNumberFile)').Trim())</_PreviousBuildNumber>
        <_PreviousBuildNumber Condition="'$(_PreviousBuildNumber)' == ''">0</_PreviousBuildNumber>
        <BuildNumber>$([MSBuild]::Add($(_PreviousBuildNumber), 1))</BuildNumber>
        <VersionPrefix>7.15.0</VersionPrefix>
        <Version>$(VersionPrefix).$(BuildNumber)</Version>
        <AssemblyVersion>$(Version)</AssemblyVersion>
        <FileVersion>$(Version)</FileVersion>
    </PropertyGroup>
    <Target Name="PersistBuildNumber" AfterTargets="Build">
        <WriteLinesToFile File="$(BuildNumberFile)" Lines="$(BuildNumber)" Overwrite="true" />
    </Target>

    <PropertyGroup>
        <TargetFramework>net9.0-windows7.0</TargetFramework>
        <Platforms>x64</Platforms>
        <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="data\*.json"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="data\*.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
        <DefineConstants>TRACE</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <!-- ⚠️ 舊結論保留,但要講清楚它管的是哪一顆:公開 NuGet 的 ECommons 3.0.1.15 是
             API14/global 世代的**二進位**套件,其 Svc 服務定位器與 API13 Dalamud 不相容 ——
             這正是本 repo 先前釘 3.0.0.18-api13 的原因,那條結論沒有被推翻。
             下面的子模組不受此限:它是**從原始碼**對本艦隊釘住的 API13 Dalamud 編出來的,
             3.0.1.15 只是 fork 的 BaseVersion,與那顆 NuGet 二進位沒有關係。 -->
        <!-- ECommons 走本 org 的 fork 子模組(BaseVersion 是 3.0.1.15,只換來源不換版本號)。
             公開 NuGet 的 ECommons 沒有我們補的判空/加固,其中 AddonMaster / ClickHelper 對
             AtkComponentBase.OwnerNode 零判空是 AVE 入口 —— AVE 在 .NET Core 是 corrupted-state
             exception,try/catch 與 HookSafety.ExecuteSafe 都攔不到,所以來源必須是 fork。
             🔴 版本號分不出來源:公開 NuGet 也有 3.0.1.15,判定只能看內容(加固版才有的
             GenericHelpers.IsComponentEnabled 等成員,公開那顆是 0)。
             驗法 tools/fleet/ecommons_hardening_check.py —— 兩軸:obj/project.assets.json 的
             ECommons 條目是 type=project ＋ 出貨目錄那顆 ECommons.dll 的標記位元組。 -->
        <ProjectReference Include="..\ECommons\ECommons\ECommons.csproj" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="data\Strings.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>Strings.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>
    
    <ItemGroup>
      <Compile Update="data\Strings.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>Strings.resx</DependentUpon>
      </Compile>
    </ItemGroup>

</Project>
